# Antigravity Quota Portal Environment Configuration Template
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env

# GCP Projects & Region (used by FastAPI app/config.py and simulation scripts)
export PROJECT_ID="your-portal-host-project"
export PORTAL_PROJECT_ID="${PROJECT_ID}"
export WORKLOAD_PROJECT_ID="your-workload-project"
export WORKLOAD_PROJECT_IDS="your-workload-project,your-workload-project-std"
export REGION="us-east5"
export BIGQUERY_DATASET="antigravity_inference_logs"

# Organization Domain & Groups
export ORG_DOMAIN="example.com"
export ENABLED_GROUP_EMAIL="antigravity-enabled@${ORG_DOMAIN}"
export DISABLED_GROUP_EMAIL="antigravity-disabled@${ORG_DOMAIN}"

# Testing Personas (used by simulation and exhaustion scripts)
export TEST_DEV1_EMAIL="dev1@${ORG_DOMAIN}"
export TEST_DEV2_EMAIL="dev2@${ORG_DOMAIN}"
export TEST_USERS_DIR="${HOME}/.agy_test_users"
# export RUN_LIVE_AGY_CLI="false"

# Optional Deployment & Build Flags (used by scripts/build_and_push.sh, deploy_cloudbuild.sh, deploy_terraform.sh)
# export IMAGE_TAG="latest"
# export AUTO_APPROVE="false"

# Application Settings (set USE_MOCK_SERVICES="false" for live GCP Firestore/BigQuery/Cloud Identity)
export USE_MOCK_SERVICES="true"
export APP_TIMEZONE="America/Los_Angeles"
export DEFAULT_QUOTA_USD="10.00"
export DEFAULT_OVERAGE_USD="2.00"
export PRESET_QUOTAS="[10.0, 15.0, 25.0, 50.0, 100.0]"
export WEBHOOK_ALERT_URL=""
export ENABLE_GCP_AUDIT_LOGGING="true"
export GCP_AUDIT_LOG_NAME="antigravity-quota-audit"
export SCHEDULER_INTERVAL_HOURS="1"
export MODEL_PRICING_CONFIG_PATH="config/model_pricing.json"
export CORS_ORIGINS="*"
export PORT="8080"
export HOST="0.0.0.0"
